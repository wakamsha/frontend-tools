{
  "name": "@wakamsha/oxlint-config",
  "version": "2.3.1",
  "description": "wakamsha's oxlint rules as an extensible shared config.",
  "exports": {
    ".": {
      "types": "./dist/configs/index.d.ts",
      "import": "./dist/configs/index.js"
    }
  },
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "oxlint --type-aware",
    "test:snapshot": "vitest",
    "build:js": "tsc -p tsconfig.build.json",
    "build:configs-json": "node ./scripts/generateConfigsJson.js && prettier --write './dist/configs/**/*.json'",
    "build:rules-json": "  node ./scripts/generateRulesJson.js   && prettier --write ./dist/rules/**/*.json",
    "build": "pnpm build:js && pnpm build:rules-json && pnpm build:configs-json",
    "release": "pnpm build && semantic-release"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wakamsha/frontend-tools.git",
    "directory": "packages/oxlint-config"
  },
  "keywords": [
    "oxlint",
    "oxlint-config",
    "lint",
    "typescript"
  ],
  "author": "wakamsha <wakamsha@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/wakamsha/frontend-tools/issues"
  },
  "homepage": "https://github.com/wakamsha/frontend-tools/tree/main/packages/oxlint-config#readme",
  "devDependencies": {
    "@types/node": "24.13.3",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "3.9.6",
    "release-config": "workspace:*",
    "semantic-release": "25.0.9",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "oxlint": "^1.70.0",
    "oxlint-tsgolint": "^0.23.0 || ^0.24.0 || ^0.25.0 || ^7.0.0"
  }
}
